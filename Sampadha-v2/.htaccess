# Hostinger (Apache/LiteSpeed) settings for racrm.fintecindia.com
Options -Indexes
DirectoryIndex index.html

RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Google returns here after Connect Gmail. The address must be on our own domain for Google to
# verify the app, so it forwards straight on to the client-gmail function with the query string.
RewriteRule ^gmail-callback$ https://nxtyswlxnmekpvlfuucg.supabase.co/functions/v1/client-gmail [R=302,QSA,L]

# The client's one link from their consent email.
RewriteRule ^client-access$ https://nxtyswlxnmekpvlfuucg.supabase.co/functions/v1/client-link [R=302,QSA,L]

# Git deployment leaves a .git folder in the web root; never serve it.
RedirectMatch 404 /\.git

# The project notes ship with the folder but describe internals, so they are not public.
RedirectMatch 404 ^/README\.md$

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Static files change on every deploy; make browsers revalidate instead of using stale copies.
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
